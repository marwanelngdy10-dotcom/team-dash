name: تقرير التقصير اليومي على تليجرام

on:
  schedule:
    # الوقت بتوقيت UTC. مثال: 6:00 UTC = 8:00 صباحًا بتوقيت القاهرة تقريبًا
    # (مصر مفيهاش توقيت صيفي حاليًا، فالفرق ثابت +2 أو +3 حسب القرار الرسمي —
    # لو عايز تظبطها بدقة استخدم https://crontab.guru وجرّب تشغيل يدوي للتأكد)
    - cron: '0 6 * * *'
  workflow_dispatch: {}   # يسمح بتشغيل يدوي من تبويب Actions للتجربة

jobs:
  send-report:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: تثبيت مكتبة pg
        run: npm install pg

      - name: تشغيل السكريبت
        run: node telegram-negligence-report.js
        env:
          DATABASE_URL: ${{ secrets.DATABASE_URL }}
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
